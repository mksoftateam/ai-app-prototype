Ran terminal command:  python -m py_compile app.py && python - <<'PY'
import os
import tempfile
import app

with tempfile.TemporaryDirectory() as directory:
    app.app.config.update(TESTING=True, DATABASE=os.path.join(directory, 'tasks.sqlite3'))
    app.init_db()
    client = app.app.test_client()
    page = client.get('/')
    assert page.status_code == 200 and 'タスクを登録'.encode() in page.data

    saved = client.post('/', data={
        'action': 'create', 'name': '設計レビュー', 'detail': '仕様を確認する',
        'due_date': '2026-10-10', 'priority': '高', 'assignee': '佐藤', 'status': '進行中',
    })
    assert saved.status_code == 302
    page = client.get('/')
    assert '設計レビュー'.encode() in page.data and '佐藤'.encode() in page.data

    invalid = client.post('/', data={
        'action': 'create', 'name': '不正な期限', 'due_date': 'not-a-date',
        'priority': '中', 'assignee': '佐藤', 'status': '未着手',
    })
    assert invalid.status_code == 200 and '期限日を正しく入力'.encode() in invalid.data
    with app.get_db() as connection:
        assert connection.execute('SELECT COUNT(*) FROM tasks').fetchone()[0] == 1
print('Page rendering, task registration, persistence, and invalid-date validation passed.')
PY

