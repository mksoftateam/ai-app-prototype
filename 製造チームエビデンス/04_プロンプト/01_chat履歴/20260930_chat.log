保存処理を追加しました。最初の確認として、まずPythonの構文チェックとFlaskテストクライアントで登録・DB保存を試し、画面側を整える前にバックエンドの想定を確かめます。

Ran terminal command:  python -m py_compile app.py && python - <<'PY'
import os
import tempfile
import app

with tempfile.TemporaryDirectory() as directory:
    app.app.config.update(TESTING=True, DATABASE=os.path.join(directory, 'tasks.sqlite3'))
    app.init_db()
    response = app.app.test_client().post('/', data={
        'name': '設計レビュー',
        'detail': '仕様を確認する',
        'due_date': '2026-10-10',
        'priority': '高',
        'assignee': '佐藤',
        'status': '進行中',
    })
    assert response.status_code == 302, response.status_code
    with app.get_db() as connection:
        task = connection.execute('SELECT * FROM tasks').fetchone()
    assert tuple(task[key] for key in ('name', 'detail', 'due_date', 'priority', 'assignee', 'status')) == (
        '設計レビュー', '仕様を確認する', '2026-10-10', '高', '佐藤', '進行中'
    )
print('Task registration and SQLite persistence passed.')
PY

